+static void smpDelayThread (void *, wait_result_t)
+{
+  IOSleep (gSmpDelay * 1000);
+  IOLog ("ArmCpu: starting the secondary cores after sheng-smp-delay=%u s\n", gSmpDelay);
+  __atomic_store_n (&gSmpDelay, 0U, __ATOMIC_RELEASE);
+  ArmCpu::drainPendingNow ();
+  thread_terminate (current_thread ());
+}
+
 void ArmCpu::drainPending (void)
+{
+  if (__atomic_load_n (&gSmpDelay, __ATOMIC_ACQUIRE) != 0) {
+    thread_t thread;
+    if (__atomic_exchange_n (&gSmpDelayStarted, 1U, __ATOMIC_ACQ_REL) == 0 &&
+        kernel_thread_start (&smpDelayThread, nullptr, &thread) == KERN_SUCCESS) {
+      thread_deallocate (thread);
+    }
+    return;
+  }
+  drainPendingNow ();
+}
