+// One queued core, for a board shell that starts the cores one at a time (sheng-smp-delay holds them): 0 started, 1 no such
+// slot, 2 not queued (already started or absent), 3 its registration failed.
+int ArmCpu::startPending (unsigned id)
+{
+  if (id == 0 || id >= ARMCPU_SMP_SLOTS) { return 1; }
+  ArmCpu *cpu = __atomic_exchange_n (&gPending[id], static_cast<ArmCpu *> (nullptr), __ATOMIC_ACQ_REL);
+  if (cpu == nullptr) { return 2; }
+  IOLog ("ArmCpu: starting core %u alone\n", id);
+  return cpu->finishSecondary () ? 0 : 3;
+}
+
+extern "C" int armcpu_start_pending (unsigned id)
+{
+  return ArmCpu::startPending (id);
+}
