 // System registers seen on each secondary core at initCPU entry: CurrentEL, SCTLR_EL1, TCR_EL1, MAIR_EL1 (low words), MIDR_EL1.
 volatile uint32_t armcpu_smp_sys[8][5], armcpu_boot_sys[5];
 volatile int32_t armcpu_smp_psci_rc[8];
+// Every step a core reached, one bit per step: armcpu_smp_step keeps only the last, and XNU 12377's ml_processor_register
+// runs startCPU (step 4) before finishSecondary records step 2.
+volatile uint32_t armcpu_smp_steps_seen[8];
+static void smpStep (uint32_t id, uint32_t step)
+{
+  armcpu_smp_step[id] = step;
+  __atomic_fetch_or (&armcpu_smp_steps_seen[id], 1U << step, __ATOMIC_RELAXED);
+}
 }
 
