+#if defined(XNU_PROC_TRACE_CONSOLE) && XNU_PROC_TRACE_CONSOLE
+/*
+ * Print every exec and spawn with its result on the console. A port whose
+ * userland has no log daemon yet can follow what launchd starts.
+ */
+static void
+exec_trace_console(proc_t p, struct image_params *imgp, int error)
+{
+	const char *path = "?";
+
+	if (imgp != NULL && imgp->ip_strings != NULL) {
+		path = imgp->ip_strings + strlen(EXECUTABLE_KEY);
+	}
+	printf("proc-trace: exec pid %d ppid %d %s error %d\n",
+	    proc_getpid(p), proc_ppid(p), path, error);
+}
+#endif
