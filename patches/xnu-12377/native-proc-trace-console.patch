+#if defined(XNU_PROC_TRACE_CONSOLE) && XNU_PROC_TRACE_CONSOLE && defined(__arm64__)
+#include <arm/thread.h>
+#include <vm/vm_shared_region_internal.h>
+#include <vm/vm_map_internal.h>
+
+/*
+ * Print the user registers, a frame-pointer backtrace and the shared cache
+ * base of a thread that raises a hardware exception. Without a crash
+ * reporter this is the only record of where userland faulted.
+ */
+static void
+exception_trace_console(task_t task, thread_t thread, exception_type_t exception,
+    mach_exception_data_t code, mach_msg_type_number_t codeCnt)
+{
+	struct arm_saved_state *state = get_user_regs(thread);
+	vm_shared_region_t shared_region;
+	mach_vm_offset_t cache = 0;
+	uint64_t frame[2], fp;
+	int pid = proc_pid(get_bsdtask_info(task));
+
+	if (exception < EXC_BAD_ACCESS || exception > EXC_BREAKPOINT || state == NULL || !is_saved_state64(state)) {
+		return;
+	}
+	shared_region = vm_shared_region_get(task);
+	if (shared_region != NULL) {
+		if (vm_shared_region_start_address(shared_region, &cache) != KERN_SUCCESS) {
+			cache = 0;
+		}
+		vm_shared_region_deallocate(shared_region);
+	}
+	printf("proc-trace: exception pid %d %s type %d codes 0x%llx 0x%llx pc 0x%llx lr 0x%llx sp 0x%llx "
+	    "far 0x%llx esr 0x%llx cache 0x%llx\n", pid, proc_name_address(get_bsdtask_info(task)), exception,
+	    (uint64_t)code[0], codeCnt > 1 ? (uint64_t)code[1] : 0, (uint64_t)get_saved_state_pc(state),
+	    (uint64_t)get_saved_state_lr(state), (uint64_t)get_saved_state_sp(state), (uint64_t)get_saved_state_far(state),
+	    get_saved_state_esr(state), (uint64_t)cache);
+	for (unsigned reg = 0; reg < 29; reg += 4) {
+		printf("proc-trace:  x%u 0x%llx 0x%llx 0x%llx 0x%llx\n", reg, (uint64_t)get_saved_state_reg(state, reg),
+		    reg + 1 < 29 ? (uint64_t)get_saved_state_reg(state, reg + 1) : 0,
+		    reg + 2 < 29 ? (uint64_t)get_saved_state_reg(state, reg + 2) : 0,
+		    reg + 3 < 29 ? (uint64_t)get_saved_state_reg(state, reg + 3) : 0);
+	}
+	fp = (uint64_t)get_saved_state_fp(state);
+	for (int depth = 0; depth < 16 && fp != 0 && (fp & 0xf) == 0; depth++) {
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		printf("proc-trace:  frame %d 0x%llx\n", depth, (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
+
+/*
+ * SIGABRT carries no text: the reason sits in the malloc heap of the aborting
+ * process ("*** Terminating app due to uncaught exception", "Assertion failed",
+ * "Fatal error"). Scan the writable malloc regions of the calling task for the
+ * best printable run, as the sheng fault probe does (package/BootFaultProbe.c).
+ */
+#define PROC_TRACE_REASON_CHUNK 65536
+static char proc_trace_reason_chunk[PROC_TRACE_REASON_CHUNK];
+static int proc_trace_reason_busy;
+
+static int
+proc_trace_reason_rank(const char *run, size_t length)
+{
+	if (strnstr(run, "uncaught exception", length) != NULL || strnstr(run, "Assertion fail", length) != NULL ||
+	    strnstr(run, "Fatal error", length) != NULL || strnstr(run, "BUG IN", length) != NULL) {
+		return 2;
+	}
+	return strnstr(run, "reason: ", length) != NULL ? 1 : 0;
+}
+
+void proc_trace_abort_reason(char *out, size_t capacity);
+void proc_trace_abort_frames(void);
+
+/*
+ * abort() raises SIGABRT on the calling thread, which takes the signal and
+ * exits: its user state is the abort site. Print it like an exception.
+ */
+void
+proc_trace_abort_frames(void)
+{
+	task_t task = current_task();
+	struct arm_saved_state *state = get_user_regs(current_thread());
+	vm_shared_region_t shared_region;
+	mach_vm_offset_t cache = 0;
+	uint64_t frame[2], fp;
+
+	if (state == NULL || !is_saved_state64(state)) {
+		return;
+	}
+	shared_region = vm_shared_region_get(task);
+	if (shared_region != NULL) {
+		if (vm_shared_region_start_address(shared_region, &cache) != KERN_SUCCESS) {
+			cache = 0;
+		}
+		vm_shared_region_deallocate(shared_region);
+	}
+	printf("proc-trace: abort pid %d %s pc 0x%llx lr 0x%llx sp 0x%llx cache 0x%llx\n",
+	    proc_pid(get_bsdtask_info(task)), proc_name_address(get_bsdtask_info(task)),
+	    (uint64_t)get_saved_state_pc(state), (uint64_t)get_saved_state_lr(state),
+	    (uint64_t)get_saved_state_sp(state), (uint64_t)cache);
+	fp = (uint64_t)get_saved_state_fp(state);
+	for (int depth = 0; depth < 24 && fp != 0 && (fp & 0xf) == 0; depth++) {
+		if (copyin((user_addr_t)fp, frame, sizeof(frame)) != 0) {
+			break;
+		}
+		printf("proc-trace:  frame %d 0x%llx\n", depth, (unsigned long long)frame[1]);
+		if (frame[0] <= fp) {
+			break;
+		}
+		fp = frame[0];
+	}
+}
+
+void
+proc_trace_abort_reason(char *out, size_t capacity)
+{
+	vm_map_t map = current_map();
+	vm_map_offset_t address = 0;
+	uint64_t scanned = 0;
+	int best = 0;
+
+	if (capacity == 0) {
+		return;
+	}
+	out[0] = 0;
+	if (__atomic_exchange_n(&proc_trace_reason_busy, 1, __ATOMIC_ACQUIRE)) {
+		return;
+	}
+	while (scanned < (160ULL << 20) && best < 2) {
+		/* The _ut types are wrapped structs or plain integers by configuration; both hold one 64-bit word. */
+		vm_map_offset_ut address_u;
+		vm_map_size_ut size_u;
+		vm_map_offset_t base;
+		vm_map_size_t size = 0;
+		vm_region_submap_info_data_64_t info;
+		mach_msg_type_number_t count = VM_REGION_SUBMAP_INFO_V2_COUNT_64;
+		natural_t depth = 0;
+
+		_Static_assert(sizeof(address_u) == sizeof(address) && sizeof(size_u) == sizeof(size), "wrapped VM words");
+		memcpy(&address_u, &address, sizeof(address));
+		memcpy(&size_u, &size, sizeof(size));
+		if (vm_map_region_recurse_64(map, &address_u, &size_u, &depth, &info, &count) != KERN_SUCCESS) {
+			break;
+		}
+		memcpy(&base, &address_u, sizeof(base));
+		memcpy(&size, &size_u, sizeof(size));
+		address = base + size;
+		if (info.is_submap || (info.protection & (VM_PROT_READ | VM_PROT_WRITE)) != (VM_PROT_READ | VM_PROT_WRITE) ||
+		    info.user_tag < VM_MEMORY_MALLOC || info.user_tag > VM_MEMORY_MALLOC_NANO) {
+			continue;
+		}
+		for (vm_map_size_t offset = 0; offset < size && best < 2; offset += PROC_TRACE_REASON_CHUNK) {
+			size_t length = size - offset < PROC_TRACE_REASON_CHUNK ? (size_t)(size - offset) : PROC_TRACE_REASON_CHUNK;
+			size_t start = 0;
+
+			if (copyin((user_addr_t)(base + offset), proc_trace_reason_chunk, length) != 0) {
+				continue;
+			}
+			scanned += length;
+			for (size_t i = 0; i <= length && best < 2; i++) {
+				if (i < length && proc_trace_reason_chunk[i] >= 0x20 && proc_trace_reason_chunk[i] < 0x7f) {
+					continue;
+				}
+				size_t run = i - start;
+				int rank = run >= 24 ? proc_trace_reason_rank(proc_trace_reason_chunk + start, run) : 0;
+				if (rank > best) {
+					size_t copied = run < capacity - 1 ? run : capacity - 1;
+					memcpy(out, proc_trace_reason_chunk + start, copied);
+					out[copied] = 0;
+					best = rank;
+				}
+				start = i + 1;
+			}
+		}
+	}
+	__atomic_store_n(&proc_trace_reason_busy, 0, __ATOMIC_RELEASE);
+}
+#endif
