 }
 
+/*********************************************************************
+* The slid address of a defined symbol of a loaded kext, from its own
+* LC_SYMTAB (UniXNU: an in-kernel driver that subclasses a prelinked kext's
+* class binds its constructor, vtable and methods by name, as a kext link
+* would). slidePrelinkedExecutable has slid every n_value. The table
+* survives only while the LINKEDIT segment is kept (keepsyms=1); 0 when the
+* kext, its symbol table or the name is absent.
+*********************************************************************/
+uintptr_t
+native_kext_symbol(const char *bundleID, const char *symbol)
+{
+	if (!bundleID || !symbol) {
+		return 0;
+	}
+	OSSharedPtr<OSKext> kext = OSKext::lookupKextWithIdentifier(bundleID);
+	if (!kext || !kext->linkedExecutable || kext->flags.jettisonLinkeditSeg) {
+		return 0;
+	}
+	kernel_mach_header_t *mh = (kernel_mach_header_t *)kext->linkedExecutable->getBytesNoCopy();
+	kernel_segment_command_t *linkedit = getsegbynamefromheader(mh, SEG_LINKEDIT);
+	struct symtab_command *symtab = (struct symtab_command *)getcommandfromheader(mh, LC_SYMTAB);
+	if (!linkedit || !symtab || symtab->symoff < linkedit->fileoff || symtab->stroff < linkedit->fileoff ||
+	    symtab->symoff - linkedit->fileoff + (uint64_t)symtab->nsyms * sizeof(kernel_nlist_t) > linkedit->vmsize ||
+	    symtab->stroff - linkedit->fileoff + (uint64_t)symtab->strsize > linkedit->vmsize) {
+		return 0;
+	}
+	const char *base = (const char *)linkedit->vmaddr - linkedit->fileoff;
+	const kernel_nlist_t *syms = (const kernel_nlist_t *)(base + symtab->symoff);
+	const char *strings = base + symtab->stroff;
+	size_t length = strlen(symbol);
+	for (uint32_t i = 0; i < symtab->nsyms; i++) {
+		if ((syms[i].n_type & N_STAB) || (syms[i].n_type & N_TYPE) != N_SECT ||
+		    syms[i].n_un.n_strx >= symtab->strsize || symtab->strsize - syms[i].n_un.n_strx <= length) {
+			continue;
+		}
+		if (!memcmp(strings + syms[i].n_un.n_strx, symbol, length + 1)) {
+			return (uintptr_t)syms[i].n_value;
+		}
+	}
+	return 0;
+}
+
 /*********************************************************************
 *
 *********************************************************************/
