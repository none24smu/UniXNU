+	NATIVE_SMP_TRACE 2
+#endif
 
 #ifdef APPLEEVEREST
 	/*
@@ -202,8 +235,14 @@ Lfound_cpu_data_entry:
 	msr		TPIDR_EL1, x13
 #endif /* __ARM_KERNEL_PROTECT__ */
 
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	NATIVE_SMP_TRACE 3
+#endif
 	blr		x0
 Lskip_cpu_reset_handler:
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	NATIVE_SMP_TRACE 8
+#endif
 	b		.									// Hang if the handler is NULL or returns
 
 	.align 3
@@ -317,6 +356,9 @@ start_cpu:
 
 	// x20 set to BootArgs phys address
 	// x21 set to cpu data phys address
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	NATIVE_SMP_TRACE 4
