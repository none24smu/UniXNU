diff --git a/osfmk/arm64/start.s b/osfmk/arm64/start.s
index dafb665..819f90f 100644
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -100,6 +100,34 @@
  *	x20 - Boot args pointer
  *	x21 - CPU data pointer
  */
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+/*
+ * A secondary core's progress through its reset path (native_smp_reset_trace, osfmk/arm/arm_init.c): one 16-byte
+ * slot per core, indexed by MPIDR Affinity1 (SM8550 and SM8350 number their cores there), holding MPIDR << 8 | step
+ * and then the TTBR1 value the core loaded from cpu_ttep. Before the MMU is on the stores reach memory directly.
+ * Uses x9-x11 only.
+ */
+.macro NATIVE_SMP_TRACE_SLOT
+	adrp	x9, EXT(native_smp_reset_trace)@page
+	add		x9, x9, EXT(native_smp_reset_trace)@pageoff
+	mrs		x10, MPIDR_EL1
+	ubfx	x11, x10, #8, #3
+	add		x9, x9, x11, lsl #4
+.endmacro
+.macro NATIVE_SMP_TRACE step
+	NATIVE_SMP_TRACE_SLOT
+	lsl		x10, x10, #8
+	add		x10, x10, #\step
+	str		x10, [x9]
+	dsb		sy
+.endmacro
+.macro NATIVE_SMP_TRACE_VALUE reg
+	NATIVE_SMP_TRACE_SLOT
+	str		\reg, [x9, #8]
+	dsb		sy
+.endmacro
+#endif
+
 	.text
 	.align 12
 	.globl EXT(LowResetVectorBase)
@@ -139,7 +167,9 @@ LEXT(reset_vector)
 	msr     VBAR_EL1, x0
 #endif
 
-
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	NATIVE_SMP_TRACE 1
+#endif
 
 	// Process reset handlers
 	adrp	x19, EXT(ResetHandlerData)@page			// Get address of the reset handler data
@@ -164,6 +194,9 @@ Lnext_cpu_data_entry:
