diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 6690846..8719e1b 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -690,6 +690,26 @@ arm_init(
 	machine_startup(args);
 }
 
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+/*
+ * A secondary core's progress through its reset path: one 16-byte slot per core, indexed by MPIDR Affinity1, holding
+ * MPIDR << 8 | step and the TTBR1 value the core loaded from cpu_ttep. osfmk/arm64/start.s writes steps 1-8 (some with
+ * the MMU off), arm_init_cpu steps 16-19. The array fills its own two cache lines, which the CPU driver cleans to
+ * memory before it starts a core.
+ */
+extern volatile uint64_t native_smp_reset_trace[16];
+__attribute__((aligned(128))) volatile uint64_t native_smp_reset_trace[16];
+
+static void
+native_smp_trace(uint64_t step)
+{
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+
+	native_smp_reset_trace[((mpidr >> 8) & 7) * 2] = (mpidr << 8) | step;
+	__builtin_arm_dsb(0xf);
+}
+#endif
+
 /*
  * Routine:        arm_init_cpu
  * Function:
@@ -704,6 +724,9 @@ arm_init_cpu(
 #if __ARM_PAN_AVAILABLE__
 	__builtin_arm_wsr("pan", 1);
 #endif
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	native_smp_trace(16);
+#endif
 
 #ifdef __arm64__
 	configure_timer_apple_regs();
@@ -757,6 +780,9 @@ arm_init_cpu(
 	cpu_machine_idle_init(FALSE);
 
 	cpu_init();
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	native_smp_trace(17);
+#endif
 
 #ifdef  APPLETYPHOON
 	if ((cpus_defeatures & (0xF << 4 * cpu_data_ptr->cpu_number)) != 0) {
@@ -786,6 +812,9 @@ arm_init_cpu(
 		commpage_update_timebase();
 	}
 	PE_init_cpu();
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	native_smp_trace(18);
+#endif
 #if __arm64__
 	apt_msg_init_cpu();
 #endif
@@ -834,6 +863,9 @@ arm_init_cpu(
 	}
 #endif
 
+#if defined(XNU_NATIVE_SMP_TRACE) && XNU_NATIVE_SMP_TRACE
+	native_smp_trace(19);
+#endif
 	secondary_cpu_main(NULL);
 }
 
